@model ArtVerse.Application.Paintings.DTOs.PaintingDetailDto
@{
    ViewData["Title"] = Model.Title + " - ArtVerse";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Quay lại thư viện tác phẩm
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-dark text-center p-2">
                @if (Model.ImageUrls.Any())
                {
                    <img src="@Model.ImageUrls.First()" class="img-fluid rounded-3 shadow" style="max-height: 550px; object-fit: contain;" alt="@Model.Title" />
                }
                else
                {
                    <div class="py-5 text-white-50">
                        <i class="bi bi-image fs-1 d-block mb-2"></i> Chưa có hình ảnh
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-light text-dark border font-monospace">@Model.Code</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@Model.Technique</span>
                </div>

                <h3 class="fw-bold mb-2">@Model.Title</h3>
                
                <div class="mb-3 p-3 bg-light rounded-3 d-flex align-items-center gap-3">
                    <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px;">
                        @(Model.StudentName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <div class="fw-bold">@Model.StudentName</div>
                        <div class="text-muted small">Nghệ sĩ học viện ArtVerse</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Mô tả tác phẩm</label>
                    <p class="mb-0">@(Model.Description ?? "Không có mô tả chi tiết.")</p>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <div class="p-2 border rounded-3 text-center">
                            <div class="text-muted small">Năm sáng tác</div>
                            <div class="fw-bold">@(Model.CreatedYear?.ToString() ?? "2026")</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded-3 text-center">
                            <div class="text-muted small">Trạng thái</div>
                            <div class="fw-bold text-success">@Model.Status</div>
                        </div>
                    </div>
                </div>

                <div class="mt-auto pt-3 border-top">
                    @if (Model.IsForSale && Model.BasePrice.HasValue)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted">Giá tác phẩm:</span>
                            <span class="fs-4 fw-bold text-success">@Model.BasePrice.Value.ToString("N0") VNĐ</span>
                        </div>
                        <button class="btn btn-primary w-100 btn-lg shadow-sm" onclick="alert('Đã gửi yêu cầu kết nối tới tác giả!');">
                            <i class="bi bi-bag-check me-1"></i> Đăng Ký Sở Hữu Tác Phẩm
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-secondary mb-0 text-center small rounded-3">
                            Tác phẩm trưng bày phi thương mại tại học viện.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
