@model IReadOnlyList<ArtVerse.Application.Paintings.DTOs.PaintingDto>
@using ArtVerse.Domain.Enums
@{
    ViewData["Title"] = "Thư Viện Tác Phẩm Nghệ Thuật";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">🎨 Thư Viện Tác Phẩm Nghệ Thuật</h2>
            <p class="text-muted mb-0">Không gian trưng bày các tác phẩm xuất sắc nhất từ học viên và giảng viên ArtVerse.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ReviewQueue" class="btn btn-outline-dark px-3">
                <i class="bi bi-card-checklist me-1"></i> Hàng Đợi Xét Duyệt
            </a>
            <a asp-action="Upload" class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-cloud-upload me-1"></i> Tải Lên Tác Phẩm
            </a>
        </div>
    </div>

    <!-- Search and Technique Filters -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control border-start-0 ps-0" 
                           placeholder="Tìm theo tên tranh, mã tranh hoặc nghệ sĩ..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="technique" class="form-select">
                    <option value="">-- Tất cả chất liệu --</option>
                    @foreach (ArtTechnique tech in Enum.GetValues(typeof(ArtTechnique)))
                    {
                        <option value="@tech" selected="@(ViewBag.Technique != null && (ArtTechnique)ViewBag.Technique == tech)">@tech</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-dark">Lọc Tranh</button>
            </div>
        </form>
    </div>

    <!-- Gallery Grid -->
    <div class="row g-4">
        @if (Model.Any())
        {
            @foreach (var art in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden artwork-card bg-white position-relative">
                        <div class="ratio ratio-4x3 bg-light overflow-hidden">
                            @if (!string.IsNullOrEmpty(art.PrimaryImageUrl))
                            {
                                <img src="@art.PrimaryImageUrl" class="card-img-top object-fit-cover transition-transform" alt="@art.Title" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center text-muted">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-light text-dark border font-monospace small">@art.Code</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">@art.Technique</span>
                            </div>
                            <h6 class="fw-bold mb-1 text-truncate" title="@art.Title">@art.Title</h6>
                            <p class="text-muted small mb-2">bởi <span class="fw-medium text-dark">@art.StudentName</span></p>
                            
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    @if (art.IsForSale && art.BasePrice.HasValue)
                                    {
                                        <span class="text-success fw-bold">@art.BasePrice.Value.ToString("N0") đ</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Triển lãm</span>
                                    }
                                </div>
                                <a asp-action="Details" asp-route-id="@art.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    Xem <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-palette fs-1 d-block mb-3 text-secondary"></i>
                <h5>Không tìm thấy tác phẩm nào phù hợp.</h5>
                <p class="small">Hãy thử tìm kiếm với từ khóa khác hoặc tải lên tác phẩm mới.</p>
            </div>
        }
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-5">
            <nav>
                <ul class="pagination shadow-sm">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-technique="@ViewBag.Technique">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
