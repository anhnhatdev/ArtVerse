@model ArtVerse.Application.Students.DTOs.StudentDto
@{
    ViewData["Title"] = "Hồ Sơ Học Viên - " + Model.FullName;
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách học viên
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <div class="avatar-circle mx-auto mb-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center rounded-circle fw-bold fs-2" style="width: 96px; height: 96px;">
                    @(Model.FullName.Substring(0, 1).ToUpper())
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <span class="badge bg-light text-dark border font-monospace mb-3">@Model.Code</span>

                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                        🎨 @Model.ArtworkCount Tác phẩm
                    </span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                        ✓ Đang học
                    </span>
                </div>

                <hr class="my-3 text-muted" />

                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                        <i class="bi bi-pencil me-1"></i> Chỉnh Sửa Thông Tin
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa học viên này?');">
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="bi bi-trash me-1"></i> Xóa Học Viên
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">📋 Thông Tin Cá Nhân</h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small">Email</label>
                        <div class="fw-medium">@Model.Email</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small">Số điện thoại</label>
                        <div class="fw-medium">@(Model.Phone ?? "Chưa cập nhật")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small">Ngày sinh</label>
                        <div class="fw-medium">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small">Giới tính</label>
                        <div class="fw-medium">@(Model.Gender?.ToString() ?? "Chưa cập nhật")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small">Ngày nhập học</label>
                        <div class="fw-medium">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">🖼️ Danh Sách Tác Phẩm Đã Sáng Tác</h5>
                    <span class="badge bg-secondary">@Model.ArtworkCount tác phẩm</span>
                </div>
                <div class="p-4 text-center text-muted bg-light rounded-3">
                    <i class="bi bi-palette fs-2 text-secondary d-block mb-2"></i>
                    Tác phẩm của học viên này sẽ được hiển thị khi liên kết ở Module Tác Phẩm.
                </div>
            </div>
        </div>
    </div>
</div>
