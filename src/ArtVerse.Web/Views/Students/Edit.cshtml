@model ArtVerse.Application.Students.DTOs.UpdateStudentDto
@{
    ViewData["Title"] = "Chỉnh Sửa Học Viên";
}

<div class="container py-4" style="max-width: 650px;">
    <div class="mb-4">
        <a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Quay lại hồ sơ học viên
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h3 class="fw-bold mb-1">✏️ Cập Nhật Thông Tin Học Viên</h3>
        <p class="text-muted small mb-4">Chỉnh sửa thông tin cá nhân của học viên.</p>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

            <div class="mb-3">
                <label class="form-label fw-medium">Họ và Tên <span class="text-danger">*</span></label>
                <input asp-for="FullName" class="form-control" required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label class="form-label fw-medium">Số điện thoại</label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-medium">Giới tính</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="Male">Nam</option>
                        <option value="Female">Nữ</option>
                        <option value="Other">Khác</option>
                    </select>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-medium">Ngày sinh</label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light px-4">Hủy</a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">Cập Nhật</button>
            </div>
        </form>
    </div>
</div>
