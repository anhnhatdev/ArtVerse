@model ArtVerse.Application.Students.DTOs.CreateStudentDto
@{
    ViewData["Title"] = "Thêm Học Viên Mới";
}

<div class="container py-4" style="max-width: 650px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách học viên
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h3 class="fw-bold mb-1">➕ Thêm Học Viên Mới</h3>
        <p class="text-muted small mb-4">Điền đầy đủ thông tin để cấp hồ sơ học viên vào học viện.</p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

            <div class="mb-3">
                <label class="form-label fw-medium">Họ và Tên <span class="text-danger">*</span></label>
                <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-medium">Email <span class="text-danger">*</span></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="an.nguyen@artverse.edu.vn" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label class="form-label fw-medium">Số điện thoại</label>
                    <input asp-for="Phone" class="form-control" placeholder="0912 345 678" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-medium">Giới tính</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="Male">Nam</option>
                        <option value="Female">Nữ</option>
                        <option value="Other">Khác</option>
                    </select>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-medium">Ngày sinh</label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light px-4">Hủy Bỏ</a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">Lưu Học Viên</button>
            </div>
        </form>
    </div>
</div>
