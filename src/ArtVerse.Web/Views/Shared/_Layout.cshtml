<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArtVerse Platform</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- ApexCharts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .navbar-brand { font-weight: 800; letter-spacing: -0.5px; }
        .nav-link { font-weight: 500; }
        .card { border-radius: 1rem; border: none; }
        .btn { border-radius: 0.5rem; }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand text-warning d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-palette-fill fs-4"></i>
                    <span>ArtVerse</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Artworks" asp-action="Index"><i class="bi bi-brush me-1"></i>Thư Viện Tranh</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Competitions" asp-action="Index"><i class="bi bi-trophy me-1"></i>Cuộc Thi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Exhibitions" asp-action="Index"><i class="bi bi-bank me-1"></i>Triển Lãm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Students" asp-action="Index"><i class="bi bi-people me-1"></i>Học Viên</a>
                        </li>

                        @if (User.IsInRole("Admin") || User.IsInRole("Principal") || User.IsInRole("Staff"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-info fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-gear-wide-connected me-1"></i>Nghiệp Vụ Chuyên Môn
                                </a>
                                <ul class="dropdown-menu shadow border-0">
                                    <li><a class="dropdown-item" asp-controller="Artworks" asp-action="ReviewQueue"><i class="bi bi-check2-square text-primary me-2"></i>Hàng Đợi Duyệt Tranh</a></li>
                                    <li><a class="dropdown-item" asp-controller="Academic" asp-action="Classes"><i class="bi bi-mortarboard text-success me-2"></i>Quản Lý Lớp Học</a></li>
                                    <li><a class="dropdown-item" asp-controller="Academic" asp-action="Subjects"><i class="bi bi-journal-text text-warning me-2"></i>Khung Môn Học</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Principal") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                            </li>
                        }
                    </ul>
                    
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                    <div>@TempData["Success"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                    <div>@TempData["Error"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="bg-dark text-secondary py-4 mt-5 border-top border-secondary border-opacity-25">
        <div class="container text-center small">
            <p class="mb-1 fw-semibold text-light">ArtVerse - Enterprise Art Academy & Digital Exhibition Platform</p>
            <p class="mb-0 text-muted">&copy; 2026 ArtVerse. Built with .NET 8 LTS & Clean Architecture.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
