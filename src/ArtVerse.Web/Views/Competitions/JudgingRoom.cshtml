@model ArtVerse.Domain.Entities.CompetitionEntry
@{
    ViewData["Title"] = "Phòng Chấm Thi - " + Model.EntryCode;
}

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Details" asp-route-id="@Model.CompetitionId" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Rời phòng chấm thi
        </a>
        <span class="badge bg-dark font-monospace fs-6">MÃ BÀI THI: @Model.EntryCode</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột Trái: Ảnh tác phẩm High-Res -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-dark text-center p-3 h-100 d-flex align-items-center justify-content-center">
                <img src="@(Model.Painting?.Files.FirstOrDefault()?.FileUrl ?? "/favicon.ico")" 
                     class="img-fluid rounded-3 shadow" style="max-height: 700px; object-fit: contain;" alt="@Model.Painting?.Title" />
            </div>
        </div>

        <!-- Cột Phải: Bảng điểm Rubric đa tiêu chí -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h4 class="fw-bold mb-1">⚖️ Hội Đồng Chấm Thi</h4>
                <p class="text-muted small mb-3">Tác phẩm: <strong class="text-dark">@Model.Painting?.Title</strong> (Thí sinh: @Model.Student?.FullName)</p>

                <div class="p-3 bg-primary-subtle text-primary rounded-3 mb-4 d-flex justify-content-between align-items-center">
                    <span class="fw-medium">Điểm trung bình hiện tại:</span>
                    <span class="fs-3 fw-bold">@Model.CalculateAverageScore().ToString("0.0") / 10</span>
                </div>

                <h6 class="fw-bold mb-3 border-bottom pb-2">Nhập Điểm Theo Tiêu Chí:</h6>

                @if (Model.Competition?.Criteria.Any() == true)
                {
                    @foreach (var crit in Model.Competition.Criteria)
                    {
                        var existingScore = Model.Scores.FirstOrDefault(s => s.CriteriaId == crit.Id);
                        <form asp-action="ScoreEntry" method="post" class="p-3 bg-light rounded-3 mb-3">
                            <input type="hidden" name="entryId" value="@Model.Id" />
                            <input type="hidden" name="criteriaId" value="@crit.Id" />

                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold">@crit.Name</span>
                                <span class="badge bg-secondary">Trọng số: @((crit.Weight * 100).ToString("0"))%</span>
                            </div>
                            <p class="text-muted small mb-2">@crit.Description</p>

                            <div class="row g-2 align-items-center">
                                <div class="col-8">
                                    <input type="number" name="score" step="0.1" min="0" max="@crit.MaxScore" 
                                           class="form-control" placeholder="Điểm (0 - @crit.MaxScore)" 
                                           value="@(existingScore?.Score.ToString("0.0") ?? "")" required />
                                </div>
                                <div class="col-4 d-grid">
                                    <button type="submit" class="btn btn-primary btn-sm">Lưu Điểm</button>
                                </div>
                            </div>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>
