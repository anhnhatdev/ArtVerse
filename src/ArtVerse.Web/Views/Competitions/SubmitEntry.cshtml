@{
    ViewData["Title"] = "Nộp Bài Dự Thi";
    var comp = ViewBag.Competition as ArtVerse.Domain.Entities.Competition;
}

<div class="container py-4" style="max-width: 650px;">
    <div class="mb-4">
        <a asp-action="Details" asp-route-id="@comp?.Id" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Quay lại chi tiết cuộc thi
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h3 class="fw-bold mb-1">📝 Nộp Bài Dự Thi</h3>
        <p class="text-muted small mb-4">Cuộc thi: <strong class="text-dark">@comp?.Title</strong></p>

        <form asp-action="SubmitEntry" asp-route-id="@comp?.Id" method="post">
            <div class="mb-4">
                <label class="form-label fw-medium">Chọn Tác Phẩm Từ Thư Viện Của Bạn <span class="text-danger">*</span></label>
                <select name="paintingId" asp-items="ViewBag.Paintings" class="form-select form-select-lg" required>
                    <option value="">-- Chọn tác phẩm đã được duyệt --</option>
                </select>
                <div class="form-text small mt-2">
                    Chỉ những tác phẩm đã được Hội đồng chuyên môn phê duyệt (Approved) mới đủ điều kiện dự thi.
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 mb-4 small text-muted">
                <i class="bi bi-info-circle me-1"></i> Bằng việc nộp bài, bạn xác nhận tác phẩm là sáng tác nguyên bản của chính bạn và đồng ý với mọi điều khoản cuộc thi.
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Details" asp-route-id="@comp?.Id" class="btn btn-light px-4">Hủy</a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">Xác Nhận Nộp Bài</button>
            </div>
        </form>
    </div>
</div>
