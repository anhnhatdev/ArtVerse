@{
    ViewData["Title"] = "Không Có Quyền Truy Cập";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4 p-5">
                <div class="mb-4">
                    <i class="bi bi-shield-slash-fill text-danger display-1"></i>
                </div>
                <h2 class="fw-bold text-danger mb-3">403 - Quyền Truy Cập Bị Từ Chối</h2>
                <p class="text-muted lead mb-4">
                    Tài khoản của bạn không có đủ thẩm quyền để truy cập vào phân hệ này. Khu vực này chỉ dành riêng cho Ban Giám Hiệu, Hội đồng nghệ thuật hoặc Quản trị viên hệ thống.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark px-4">
                        <i class="bi bi-house me-1"></i> Về Trang Chủ
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-dark px-4">
                        <i class="bi bi-person-gear me-1"></i> Đổi Tài Khoản Khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
