@model IReadOnlyList<ArtVerse.Application.Academic.DTOs.EnrollmentDto>
@{
    var classInfo = ViewBag.ClassInfo as ArtVerse.Application.Academic.DTOs.ClassDto;
    ViewData["Title"] = "Danh Sách Lớp - " + classInfo?.Name;
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Classes" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách lớp học
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-light text-dark border font-monospace mb-2">@classInfo?.Code</span>
                <h3 class="fw-bold mb-1">@classInfo?.Name</h3>
                <p class="text-muted small mb-0">Năm học @classInfo?.Year - Học kỳ @classInfo?.Semester | Sĩ số hiện tại: @Model.Count / @classInfo?.MaxStudents</p>
            </div>
            <button class="btn btn-primary px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#enrollModal">
                <i class="bi bi-person-plus-fill me-1"></i> Ghi Danh Học Viên
            </button>
        </div>
    </div>

    <!-- Student Roster Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã HV</th>
                        <th>Họ và Tên Học Viên</th>
                        <th>Trạng Thái Ghi Danh</th>
                        <th>Ngày Ghi Danh</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="ps-4"><span class="badge bg-light text-dark border font-monospace">@student.StudentCode</span></td>
                                <td class="fw-bold">@student.StudentName</td>
                                <td><span class="badge bg-success-subtle text-success border border-success-subtle">@student.Status</span></td>
                                <td class="text-muted small">@student.EnrolledAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                                Lớp học chưa có học viên ghi danh. Bấm "Ghi Danh Học Viên" để thêm vào lớp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Enroll -->
<div class="modal fade" id="enrollModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow rounded-4">
            <form asp-action="EnrollStudent" method="post">
                <input type="hidden" name="classId" value="@classInfo?.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Ghi Danh Học Viên Vào Lớp</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label fw-medium">Chọn học viên từ danh sách</label>
                    <select name="studentId" asp-items="ViewBag.AvailableStudents" class="form-select form-select-lg" required>
                        <option value="">-- Chọn học viên --</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4">Xác Nhận Ghi Danh</button>
                </div>
            </form>
        </div>
    </div>
</div>
