@{
    ViewData["Title"] = "Trang Chủ";
}

<div class="hero-section text-center py-5 px-3">
    <div class="container py-4">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill mb-3">
            ✨ Nền Tảng Quản Lý Học Viện Nghệ Thuật & Triển Lãm Số
        </span>
        <h1 class="display-4 fw-bold mb-3 text-gradient">
            Khơi Nguồn Sáng Tạo, Lan Tỏa Đam Mê Nghệ Thuật
        </h1>
        <p class="lead text-muted mx-auto mb-4" style="max-width: 700px;">
            ArtVerse kết nối học viên, giảng viên, hội đồng chuyên môn và các nhà sưu tập nghệ thuật trong một hệ sinh thái số hiện đại, minh bạch và chuyên nghiệp.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/Identity/Account/Login" class="btn btn-primary btn-lg px-4 shadow-sm">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Hệ Thống
            </a>
            <a href="/Identity/Account/Register" class="btn btn-outline-secondary btn-lg px-4">
                <i class="bi bi-person-plus me-1"></i> Đăng Ký Tài Khoản
            </a>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card">
                <div class="icon-box bg-primary text-white rounded-3 mb-3 d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    🎨
                </div>
                <h5 class="fw-bold mb-2">Quản Lý Tác Phẩm & Portfolio</h5>
                <p class="text-muted mb-0">Học viên dễ dàng lưu trữ, quản lý tác phẩm số chất lượng cao và xây dựng hồ sơ nghệ sĩ chuyên nghiệp.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card">
                <div class="icon-box bg-warning text-dark rounded-3 mb-3 d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    🏆
                </div>
                <h5 class="fw-bold mb-2">Cuộc Thi Mỹ Thuật Trực Tuyến</h5>
                <p class="text-muted mb-0">Quy trình nộp bài, chấm điểm theo Rubric đa tiêu chí và tổng hợp giải thưởng hoàn toàn minh bạch.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card">
                <div class="icon-box bg-success text-white rounded-3 mb-3 d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    🏛️
                </div>
                <h5 class="fw-bold mb-2">Triển Lãm & Sàn Giao Dịch</h5>
                <p class="text-muted mb-0">Tổ chức sự kiện triển lãm trực tiếp lẫn ảo, kết nối nhà sưu tập để thương mại hóa tác phẩm xuất sắc.</p>
            </div>
        </div>
    </div>

    <div class="mt-5 p-4 rounded-4 bg-light border border-light-subtle">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h5 class="fw-bold mb-1">🔑 Tài khoản Quản trị viên mặc định (Seed Account):</h5>
                <p class="mb-0 text-muted">Email: <code>admin@artverse.com</code> | Mật khẩu: <code>Admin@123</code></p>
            </div>
            <a href="/Identity/Account/Login" class="btn btn-dark px-4">Đăng nhập Admin</a>
        </div>
    </div>
</div>
